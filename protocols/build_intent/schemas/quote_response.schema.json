{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quote Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quote_response_id",
    "quote_request_id",
    "responder_name",
    "responder_type",
    "quoted_scope",
    "price_min",
    "price_max",
    "currency",
    "lead_time_min_days",
    "lead_time_max_days",
    "assumptions",
    "exclusions",
    "substitutions",
    "confidence_score",
    "risk_notes",
    "clarification_questions",
    "human_review_required"
  ],
  "properties": {
    "quote_response_id": { "type": "string" },
    "quote_request_id": { "type": "string" },
    "responder_name": { "type": "string" },
    "responder_type": { "type": "string" },
    "quoted_scope": { "type": "string" },
    "price_min": { "type": "number", "minimum": 0 },
    "price_max": { "type": "number", "minimum": 0 },
    "currency": { "type": "string" },
    "lead_time_min_days": { "type": "integer", "minimum": 0 },
    "lead_time_max_days": { "type": "integer", "minimum": 0 },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "substitutions": { "type": "array", "items": { "type": "string" } },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "risk_notes": { "type": "array", "items": { "type": "string" } },
    "clarification_questions": { "type": "array", "items": { "type": "string" } },
    "human_review_required": { "type": "boolean", "const": true },
    "external_action_taken": { "type": "boolean", "const": false },
    "sandbox_only": { "type": "boolean" }
  }
}