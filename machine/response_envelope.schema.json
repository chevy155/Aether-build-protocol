{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-build-protocol.local/schemas/response_envelope.schema.json",
  "title": "Aether Machine Response Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_id",
    "response_type",
    "status",
    "timestamp",
    "protocol_version",
    "operation",
    "artifact_id",
    "human_review_required",
    "external_action_taken",
    "message",
    "next_safe_actions",
    "forbidden_actions",
    "evidence",
    "errors",
    "warnings"
  ],
  "properties": {
    "response_id": {"type": "string"},
    "response_type": {
      "type": "string",
      "enum": ["success", "error", "warning", "refusal", "human_approval_required"]
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "WARN", "BLOCKED"]
    },
    "timestamp": {"type": "string"},
    "protocol_version": {"type": "string"},
    "operation": {"type": "string"},
    "artifact_id": {"type": "string"},
    "human_review_required": {"type": "boolean"},
    "external_action_taken": {
      "type": "boolean",
      "const": false
    },
    "message": {"type": "string"},
    "next_safe_actions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "forbidden_actions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "severity": {"type": "string"}
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "severity": {"type": "string"}
        }
      }
    },
    "generated_artifacts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "approval_required_for": {
      "type": "array",
      "items": {"type": "string"}
    },
    "suggested_human_action": {"type": "string"},
    "related_docs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "related_schema": {"type": "string"},
    "request_echo": {
      "type": "object",
      "additionalProperties": true
    }
  }
}