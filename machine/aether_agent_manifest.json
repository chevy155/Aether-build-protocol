{
  "protocol_name": "Aether Build Protocol",
  "protocol_version": "0.2.8",
  "protocol_type": "machine_readable_physical_build_intent",
  "current_mode": "local_only_sandbox",
  "primary_use_cases": [
    "schema_validation",
    "quote_request_generation",
    "quote_response_validation",
    "quote_readiness_analysis",
    "local_simulation",
    "integration_mapping",
    "artifact_provenance_review",
    "mcp_drive_agent_proof",
    "human_approval_gate_review"
  ],
  "safe_for": [
    "schema_validation",
    "quote_readiness_analysis",
    "local_simulation",
    "integration_mapping",
    "artifact_provenance_review",
    "mcp_drive_agent_proof",
    "human_approval_gate_review"
  ],
  "not_safe_for": [
    "supplier_contact",
    "quote_routing",
    "contractor_selection",
    "fabrication_approval",
    "engineering_approval",
    "payment_approval",
    "load_certification"
  ],
  "human_approval_required_for": [
    "external_release",
    "real_company_integration",
    "supplier_contact",
    "production_api_enablement",
    "email_sending",
    "webhook_delivery"
  ],
  "source_of_truth_paths": [
    "README.md",
    "protocols/build_intent/schemas/",
    "machine/permission_manifest.json",
    "docs/GUARDRAILS.md"
  ],
  "schema_paths": [
    "protocols/build_intent/schemas/build_packet.schema.json",
    "protocols/build_intent/schemas/bom_item.schema.json",
    "protocols/build_intent/schemas/capability_requirement.schema.json",
    "protocols/build_intent/schemas/quote_request.schema.json",
    "protocols/build_intent/schemas/quote_response.schema.json",
    "protocols/build_intent/schemas/negotiation_event.schema.json",
    "protocols/build_intent/schemas/outcome_event.schema.json"
  ],
  "script_paths": [
    "scripts/validate_build_packet.py",
    "scripts/generate_quote_request.py",
    "scripts/generate_rfq_markdown.py",
    "scripts/generate_agent_manifest.py",
    "scripts/validate_quote_response.py",
    "scripts/score_quote_readiness.py",
    "scripts/generate_negotiation_event.py",
    "scripts/generate_outcome_event.py",
    "scripts/generate_quote_comparison_summary.py",
    "scripts/run_mcp_drive_agent_test.py"
  ],
  "simulation_paths": [
    "scripts/simulate_industrial_hook_pipeline.py",
    "scripts/simulate_company_integration.py",
    "scripts/simulate_asi_network_sense.py",
    "scripts/run_mcp_drive_agent_test.py"
  ],
  "integration_paths": [
    "integrations/company_sandbox/",
    "network/",
    "machine/",
    "openapi/",
    "mcp/"
  ],
  "output_paths": [
    "outputs/",
    "outputs/mcp_drive/",
    "simulations/industrial_hook/outputs/",
    "integrations/company_sandbox/ledger/"
  ],
  "guardrail_docs": [
    "docs/GUARDRAILS.md",
    "docs/COMPANY_CONNECTION_REQUIREMENTS.md",
    "docs/PERMISSION_BOUNDARY_SPEC.md",
    "docs/MACHINE_TO_MACHINE_GATEWAY.md"
  ],
  "contact_policy": "No supplier, contractor, or external system contact is allowed without explicit human approval.",
  "external_action_policy": "External actions remain forbidden by default in local_only_sandbox mode."
}